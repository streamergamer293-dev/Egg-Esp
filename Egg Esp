--// DRAGGING
local dragging = false
local dragStart
local startPosition

hdr.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = true
		dragStart = input.Position
		startPosition = panel.Position
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then

		dragging = false
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType ~= Enum.UserInputType.MouseMovement
		and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	local delta = input.Position - dragStart

	panel.Position = UDim2.new(
		startPosition.X.Scale,
		startPosition.X.Offset + delta.X,
		startPosition.Y.Scale,
		startPosition.Y.Offset + delta.Y
	)
end)

--// FREEZE
local function freezePart(part)
	if not part or not part:IsA("BasePart") then
		return
	end

	part.Anchored = true
	part.AssemblyLinearVelocity = Vector3.zero
	part.AssemblyAngularVelocity = Vector3.zero
end

local function unfreezeCharacter(char)
	if not char then
		return
	end

	local hum = char:FindFirstChildOfClass("Humanoid")

	if hum then
		hum.WalkSpeed = 16
		hum.JumpPower = 50

		pcall(function()
			hum.JumpHeight = 7.2
		end)

		hum.AutoRotate = true
		hum.PlatformStand = false
	end

	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = false
		end
	end
end

local function freezeCharacter(char)
	if not char then
		return
	end

	local hum = char:FindFirstChildOfClass("Humanoid")

	if hum then
		hum.WalkSpeed = 0
		hum.JumpPower = 0

		pcall(function()
			hum.JumpHeight = 0
		end)

		hum.AutoRotate = false
		hum.PlatformStand = true
	end

	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			freezePart(part)
		end
	end
end

--// ESP STORAGE
local tracked = {}

local function getAdornee(obj)
	if not obj then
		return nil
	end

	if obj:IsA("BasePart") then
		return obj
	end

	if obj:IsA("Model") then
		return obj.PrimaryPart
			or obj:FindFirstChild("HumanoidRootPart")
			or obj:FindFirstChildWhichIsA("BasePart")
	end

	return obj:FindFirstAncestorWhichIsA("BasePart")
end

local function getModel(obj)
	if not obj then
		return nil
	end

	if obj:IsA("Model") then
		return obj
	end

	return obj:FindFirstAncestorOfClass("Model") or obj
end

--// REMOVE ESP
local function removeESP(obj)
	local data = tracked[obj]

	if not data then
		return
	end

	pcall(function()
		data.highlight:Destroy()
	end)

	pcall(function()
		data.billboard:Destroy()
	end)

	pcall(function()
		data.beam:Destroy()
	end)

	pcall(function()
		data.att0:Destroy()
	end)

	pcall(function()
		data.att1:Destroy()
	end)

	tracked[obj] = nil
end

local function clearAllESP()
	local objects = {}

	for obj in pairs(tracked) do
		table.insert(objects, obj)
	end

	for _, obj in ipairs(objects) do
		removeESP(obj)
	end
end

--// ADD ESP
local function addESP(obj, pretty, isImportant)
	if not espOn or not obj then
		return
	end

	addRow(pretty, isImportant)

	local model = getModel(obj)

	if not model then
		return
	end

	if tracked[model] then
		tracked[model].name = pretty
		tracked[model].important = isImportant
		return
	end

	local adornee = getAdornee(model) or getAdornee(obj)

	if not adornee then
		return
	end

	--// Highlight
	local hl = Instance.new("Highlight")
	hl.Name = "EggESP"

	hl.FillTransparency = isImportant and 0.5 or 0.75
	hl.OutlineTransparency = 0
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

	if model:IsA("Model") then
		hl.Adornee = model
	else
		hl.Adornee = adornee
	end

	hl.Parent = model

	--// Billboard
	local bb = Instance.new("BillboardGui")
	bb.Name = "EggESPName"
	bb.Size = UDim2.new(0, 240, 0, 40)
	bb.StudsOffset = Vector3.new(0, 3.2, 0)
	bb.AlwaysOnTop = true
	bb.MaxDistance = 2000
	bb.Adornee = adornee
	bb.Parent = adornee

	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = pretty
	label.Font = Enum.Font.GothamBold
	label.TextSize = isImportant and 16 or 14
	label.TextStrokeTransparency = 0.2
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextColor3 = NORMAL_COLOR
	label.Parent = bb

	--// Beam attachments
	local att0 = Instance.new("Attachment")
	att0.Name = "EggESP_A0"
	att0.Parent = adornee

	local att1 = Instance.new("Attachment")
	att1.Name = "EggESP_A1"

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	if root then
		att1.Parent = root
	end

	--// Beam
	local beam = Instance.new("Beam")
	beam.Name = "EggESPBeam"
	beam.Attachment0 = att0
	beam.Attachment1 = att1
	beam.Width0 = isImportant and 0.14 or 0.06
	beam.Width1 = isImportant and 0.14 or 0.06
	beam.FaceCamera = true
	beam.LightEmission = 1
	beam.Transparency = NumberSequence.new(
		isImportant and 0.1 or 0.45
	)
	beam.Parent = adornee

	tracked[model] = {
		name = pretty,
		important = isImportant,

		highlight = hl,
		billboard = bb,
		label = label,

		beam = beam,
		att0 = att0,
		att1 = att1,

		adornee = adornee
	}
end

--// TRY ESP
local function tryESP(inst, text)
	if not looksLikeEgg(text) then
		return false
	end

	addESP(
		inst,
		displayName(text),
		importantName(text) ~= nil
	)

	return true
end

--// SCAN
local function scan(inst)
	if not espOn or not inst then
		return
	end

	if inst:IsA("Highlight")
		or inst:IsA("BillboardGui")
		or inst:IsA("Beam")
		or inst:IsA("Attachment") then
		return
	end

	if inst:IsA("BasePart") or inst:IsA("Model") then
		if tryESP(inst, inst.Name) then
			return
		end
	end

	if inst:IsA("TextLabel") or inst:IsA("TextButton") then
		tryESP(inst, inst.Text)
	end
end

--// FULL SCAN
local function fullScan()
	if not espOn then
		return
	end

	-- Remove deleted objects
	local toRemove = {}

	for obj in pairs(tracked) do
		if not obj.Parent then
			table.insert(toRemove, obj)
		end
	end

	for _, obj in ipairs(toRemove) do
		removeESP(obj)
	end

	-- Scan workspace
	for _, inst in ipairs(workspace:GetDescendants()) do
		scan(inst)
	end

	-- Stats
	local count = 0
	local importantCount = 0

	for _, data in pairs(tracked) do
		count += 1

		if data.important then
			importantCount += 1
		end
	end

	stats.Text = count .. " eggs  |  " .. importantCount .. " rainbow"
end

