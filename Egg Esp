--// ESP UPDATE
RunService.Heartbeat:Connect(function()
	-- Keep character frozen
	if frozen and player.Character then
		freezeCharacter(player.Character)
	end

	if not espOn then
		return
	end

	local rain = rainbow()

	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")

	for obj, data in pairs(tracked) do
		if not obj.Parent then
			removeESP(obj)
			continue
		end

		local color = data.important
			and rain
			or NORMAL_COLOR

		-- Highlight
		if data.highlight then
			data.highlight.FillColor = color
			data.highlight.OutlineColor = color
		end

		-- Beam
		if data.beam then
			data.beam.Color = ColorSequence.new(color)
		end

		-- Distance
		local distanceText = ""

		if root and data.adornee and data.adornee:IsA("BasePart") then
			local distance = math.floor(
				(root.Position - data.adornee.Position).Magnitude
			)

			distanceText = "  [" .. distance .. "m]"

			if data.att1 and data.att1.Parent ~= root then
				data.att1.Parent = root
			end

			if data.beam then
				data.beam.Attachment1 = data.att1
			end
		end

		-- Billboard text
		if data.label then
			data.label.Text = data.name .. distanceText
			data.label.TextColor3 = color
		end

		-- List row
		local rowData = rowMap[data.name]

		if rowData and rowData.row then
			rowData.row.TextColor3 = color
		end
	end
end)

