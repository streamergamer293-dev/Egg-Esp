--// LOOKUP
local LOOKUP = {}

for _, name in ipairs(IMPORTANT) do
	LOOKUP[string.lower(name)] = name
end

local function norm(text)
	text = string.lower(tostring(text or ""))
	text = string.gsub(text, "^%s+", "")
	text = string.gsub(text, "%s+$", "")
	text = string.gsub(text, "%s+", " ")
	return text
end

local function importantName(text)
	return LOOKUP[norm(text)]
end

local function looksLikeEgg(text)
	local n = norm(text)

	if n == "" or n == "egg" then
		return false
	end

	if importantName(n) then
		return true
	end

	if string.sub(n, -4) == " egg" then
		return true
	end

	if string.sub(n, -3) == "egg" and #n > 4 then
		return true
	end

	return false
end

local function displayName(text)
	return importantName(text) or tostring(text)
end

local function rainbow()
	return Color3.fromHSV((tick() * 0.25) % 1, 1, 1)
end

